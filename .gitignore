CODING_RULES.md
.worktrees/
.cursor/config.json
reference/
test-*
!scripts/test-e2e.sh
workbench/
target/
dist/
node_modules/
vendor/
.cursor/
artifacts/
docs/unyform/output/
.DS_Store

# cargo-mutants reports (regenerated per run; CI uploads them as an artifact)
mutants.out/
mutants.out.old/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key

# Secrets — never commit
.env.secrets
.env*.local

# site/ — nested mx project (Astro app at site/apps/site)
site/apps/site/node_modules/
site/apps/site/dist/
site/apps/site/.astro/
site/tmp/
site/docker/.compose/
# Env files are generated by `mx add` from the recipe; never committed here
site/docker/.config/.env*
