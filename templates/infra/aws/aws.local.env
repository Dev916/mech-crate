# Emulator lane. Committed on purpose: nothing in this file is a credential.
#
# Point an app container at the emulator by adding this file to its env_file
# list. On the workstation, `eval "$(make aws-env)"` exports the same values
# with the router hostname as the endpoint.
#
# A 12-digit access key is the account id in the emulator, so tests can isolate
# themselves by using a different 12-digit key each.
AWS_ENDPOINT_URL=http://aws:4566
AWS_ACCESS_KEY_ID=000000000000
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1
AWS_EC2_METADATA_DISABLED=true
