# {{SERVICE_NAME}} - Rust API Configuration

# Server
{{SERVICE_UPPER}}_PORT=3000
PORT=3000

# Database
# Derived from the generated credentials: scripts/generate-secrets.sh resolves
# these references into literals (compose never interpolates an env_file value
# from a sibling env file, so a reference left here would reach the app empty).
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST:-db}:${DB_PORT:-5432}/${DB_NAME}

# Environment
RUST_ENV=production
RUST_LOG=info,{{SERVICE_SLUG}}=debug
