# {{SERVICE_NAME}} Environment Configuration
# Generated by MechCrate Rust-Worker Recipe

# Logging
RUST_LOG=info,{{SERVICE_SLUG}}=debug

# Database
# Derived from the generated credentials: scripts/generate-secrets.sh resolves
# these references into literals. Two reasons it has to be done here and not in
# the compose file: compose never interpolates an env_file value from a sibling
# env file (a reference left here would reach the worker empty), and an
# `environment:` block outranks every env_file layer, so the same URL written
# there would overwrite this one (bd:mech-crate-q1w).
DATABASE_URL=postgres://${DB_USER}:${DB_PASSWORD}@${DB_HOST:-db}:${DB_PORT:-5432}/${DB_NAME}

# Redis
REDIS_URL=redis://redis:6379
CHANNEL=jobs

# Worker Configuration
WORKER_THREADS={{WORKERS}}
BATCH_SIZE={{BATCH_SIZE}}
SHUTDOWN_TIMEOUT=30

# Metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# LLM (optional)
LLM_ENABLED=false
LLM_MODEL_PATH=/models/model.gguf
