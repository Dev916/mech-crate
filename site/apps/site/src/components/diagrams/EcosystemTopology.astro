---
/**
 * One workstation router, N mx projects, only a subset of services up.
 *
 * A named handle on `./sources/ecosystem-topology.mmd` so pages can embed it without
 * remembering the slug. All the behaviour lives in `./Diagram.astro`.
 *
 *   import EcosystemTopology from '@/components/diagrams/EcosystemTopology.astro';
 *   <EcosystemTopology />
 */
import Diagram from './Diagram.astro';

interface Props {
  /** Override the registry caption, or pass `false` to render none. */
  caption?: string | false;
  class?: string;
}

const { caption, class: className } = Astro.props;
---

<Diagram name="ecosystem-topology" caption={caption} class={className} />
