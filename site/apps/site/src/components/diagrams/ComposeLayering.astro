---
/**
 * Baseline compose file plus dev override, merged into the effective dev stack.
 *
 * A named handle on `./sources/compose-layering.mmd` so pages can embed it without
 * remembering the slug. All the behaviour lives in `./Diagram.astro`.
 *
 *   import ComposeLayering from '@/components/diagrams/ComposeLayering.astro';
 *   <ComposeLayering />
 */
import Diagram from './Diagram.astro';

interface Props {
  /** Override the registry caption, or pass `false` to render none. */
  caption?: string | false;
  class?: string;
}

const { caption, class: className } = Astro.props;
---

<Diagram name="compose-layering" caption={caption} class={className} />
