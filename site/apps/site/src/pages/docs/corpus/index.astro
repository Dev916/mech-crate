---
/**
 * `/docs/corpus/` — the corpus overview.
 *
 * Generated from the `docs` collection at build time rather than hand-authored:
 * the corpus grows by adding a file to `docs/development/`, so any list that has
 * to be maintained by hand would be stale the day it is written.
 *
 * Rendered through `<StarlightPage>` so it keeps the Starlight shell (sidebar,
 * search, table of contents) without being a collection entry itself — the
 * collection is reserved for corpus documents, which is what the autogenerated
 * "Techniques Corpus" sidebar group is built from.
 */
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import { categoryLabel, isCorpusEntry } from '../../../components/corpus.ts';

const entries = (await getCollection('docs')).filter(isCorpusEntry);

const byCategory = new Map<string, number>();
for (const entry of entries) {
  const { category } = entry.data.corpus;
  byCategory.set(category, (byCategory.get(category) ?? 0) + 1);
}

const categories = [...byCategory.entries()]
  .map(([category, count]) => ({
    category,
    count,
    label: categoryLabel(category),
    href: `/docs/corpus/${category}/`,
  }))
  .sort((a, b) => a.label.localeCompare(b.label));

const total = entries.length;
---

<StarlightPage
  frontmatter={{
    title: 'Techniques Corpus',
    description:
      "Every publishable document in mx's agent corpus, grouped by category. Agents retrieve these pages via the MCP `rag_context` tool.",
  }}
>
  <p>
    These {total} documents are the corpus <code>mx</code> ships to agents. The same files back the
    MCP <code>rag_context</code> tool, so what an agent retrieves and what you read here are the same
    text — published straight from <code>docs/development/</code> in the repository, with no separate
    copy to drift.
  </p>

  <p>
    Browse by category below, or use the site search. Researched documents carry a provenance footer
    listing the sources they were built from.
  </p>

  <ul class="corpus-categories">
    {
      categories.map(({ href, label, count }) => (
        <li>
          <a href={href}>{label}</a>
          <span class="corpus-categories__count">
            {count} doc{count === 1 ? '' : 's'}
          </span>
        </li>
      ))
    }
  </ul>
</StarlightPage>

<style>
  .corpus-categories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    gap: 0.5rem;
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .corpus-categories li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
  }

  .corpus-categories__count {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
    white-space: nowrap;
  }
</style>
