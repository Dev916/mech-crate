---
/**
 * `/docs/corpus/<category>/` — one index page per corpus category.
 *
 * Paths come from the collection, so a new `category:` value in a doc's
 * frontmatter produces its index page with no config change. These pages sit in
 * `src/pages/` rather than the collection on purpose: the collection is what the
 * autogenerated "Techniques Corpus" sidebar group is built from, and adding
 * synthetic index entries there would put generated pages in the doc tree.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';

import {
  categoryLabel,
  isCorpusEntry,
  provenanceSummary,
  type CorpusEntry,
} from '../../../components/corpus.ts';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = (await getCollection('docs')).filter(isCorpusEntry);

  const byCategory = new Map<string, CorpusEntry[]>();
  for (const entry of entries) {
    const { category } = entry.data.corpus;
    const bucket = byCategory.get(category);
    if (bucket) bucket.push(entry);
    else byCategory.set(category, [entry]);
  }

  return [...byCategory.entries()].map(([category, docs]) => ({
    params: { category },
    props: {
      docs: docs
        .map((entry) => ({
          title: entry.data.title,
          description: entry.data.description,
          href: `/${entry.id}/`,
          provenance: provenanceSummary(entry.data.corpus),
        }))
        .sort((a, b) => a.title.localeCompare(b.title)),
    },
  }));
};

const { category } = Astro.params;
const { docs } = Astro.props;
const label = categoryLabel(category!);
---

<StarlightPage
  frontmatter={{
    title: `${label}: Techniques Corpus`,
    // Kept in step with the same sentence in `generatedNavPages()`
    // (src/loaders/lib/llms-pages.ts), which is what /llms.txt quotes for this page.
    description: `The ${docs.length} ${label.toLowerCase()} document${docs.length === 1 ? '' : 's'} in mx's agent corpus.`,
  }}
>
  <p>
    {docs.length}
    {docs.length === 1 ? 'document' : 'documents'} filed under <code>{category}</code>. Every one of
    them is retrievable by agents through <code>rag_context</code>.
    <a href="/docs/corpus/">All categories</a>.
  </p>

  <ul class="corpus-list">
    {
      docs.map((doc) => (
        <li>
          <a href={doc.href}>{doc.title}</a>
          {doc.description && <p class="corpus-list__summary">{doc.description}</p>}
          {doc.provenance && <p class="corpus-list__provenance">{doc.provenance}</p>}
        </li>
      ))
    }
  </ul>
</StarlightPage>

<style>
  .corpus-list {
    margin-top: 1.5rem;
    padding: 0;
    list-style: none;
  }

  .corpus-list li {
    padding-block: 0.7rem;
    border-top: 1px solid var(--sl-color-gray-6);
  }

  .corpus-list li:first-child {
    border-top: 0;
  }

  .corpus-list__summary {
    margin: 0.2rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }

  .corpus-list__provenance {
    margin: 0.2rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
