---
// Custom landing page — deliberately NOT a Starlight doc. Starlight owns
// /docs/**; this route stays a hand-authored Astro page so the hero, the four
// problem sections, the AI-layer loop and the CTA can be laid out freely
// (see docs/superpowers/specs/2026-08-20-mechcrate-site-design.md — IA).
//
// The copy is adapted from the repo README's "problems it exists to solve"
// narrative — tightened for the web, never pasted — and it inherits the
// README's honesty rules: no capability is claimed past what ships, `mx upgrade`
// is described as mid-repair, and the locality claim about the corpus is about
// the *store*, not the embedding provider (which is OpenAI by default).
import { Image, getImage } from 'astro:assets';

import logo from '@/assets/mechcrate-logo.png';
import ComposeLayering from '@/components/diagrams/ComposeLayering.astro';
import EcosystemTopology from '@/components/diagrams/EcosystemTopology.astro';
import RecipeInstallFlow from '@/components/diagrams/RecipeInstallFlow.astro';
import FolderContract from '@/components/diagrams/FolderContract.astro';
import AiLoop from '@/components/diagrams/AiLoop.astro';

import { homepageGraph, jsonLdScript } from '@/lib/jsonld.ts';
import { OG_CARD_HEIGHT, OG_CARD_TYPE, OG_CARD_WIDTH, ogCardUrl } from '@/lib/og.ts';
import { SITE_ORIGIN } from '@/loaders/lib/llms.ts';
import { commonHeadHtml } from '@/lib/site-head.ts';
import { CF_BEACON_TOKEN, GITHUB_REPO, LANDING_DESCRIPTION, LANDING_TITLE } from '@/site-meta.ts';
import '@/styles/landing.css';

// Shared with /llms.txt, which quotes the same two strings for the `/` bullet —
// see src/site-meta.ts.
const title = LANDING_TITLE;
const description = LANDING_DESCRIPTION;

const repo = GITHUB_REPO;

// The landing page carries the three site-level entities (spec §4): the
// Organization every docs page's `publisher` @id points back at, the WebSite,
// and mx itself as a SoftwareApplication. The docs pages get theirs from the
// <Head> override; this route is not a Starlight route, so it emits its own.
//
// The logo goes through `getImage()` rather than `logo.src` because the raw
// import is only a build-time handle — Astro emits the optimized derivative the
// <Image> below asks for (a .webp), and nothing else. Asking explicitly for a
// PNG both emits the file and keeps the format Google's Organization logo
// guidance wants; `.src` is then a real, hashed, absolute-able URL.
const logoPng = await getImage({ src: logo, format: 'png', width: 512, height: 512 });

const jsonLd = jsonLdScript(
  homepageGraph({ url: new URL(logoPng.src, SITE_ORIGIN).href, width: 512, height: 512 })
);

// Rendered one line per entry and copied newline-joined, so what the Copy
// button puts on the clipboard is exactly what is on screen. Kept to two lines
// because the single `&&` chain is ~90 monospace characters and clips out of
// the hero column on anything narrower than a desktop.
const installLines = [
  'git clone https://github.com/Dev916/mech-crate.git',
  'cd mech-crate && make install-local',
];
const installCommand = installLines.join('\n');

// The closing CTA shows the install plus the two commands that follow it. The
// `$` prompts and the trailing `#` comments are decoration, so neither the
// clipboard nor the accessibility tree gets them.
const startCommand = [
  ...installLines,
  'mx router install && mx router up',
  'mx new my-app',
].join('\n');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href="https://mechcrate.dev/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://mechcrate.dev/" />
    {/* Parity with what Starlight's head defaults give every /docs/** page:
        the site name and the locale. Values match `title:` in astro.config.mjs
        and the site's single locale — this route is hand-written, so nothing
        supplies them for it. */}
    <meta property="og:site_name" content="MechCrate" />
    <meta property="og:locale" content="en" />
    <meta name="twitter:card" content="summary_large_image" />
    {/* Twitter reads og:title/og:description when these are absent, but the
        landing page is the one URL people paste into a post, so it states them
        rather than relying on the fallback. */}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    {/* The landing page is not a Starlight route, so the card tags the
        <Head> override adds to /docs/** are written out here by hand. Same
        helper, same card endpoint — this one resolves to /og/index.png. */}
    <meta property="og:image" content={ogCardUrl('/')} />
    <meta property="og:image:type" content={OG_CARD_TYPE} />
    <meta property="og:image:width" content={String(OG_CARD_WIDTH)} />
    <meta property="og:image:height" content={String(OG_CARD_HEIGHT)} />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:image" content={ogCardUrl('/')} />

    {/* Organization + WebSite + SoftwareApplication, one block, already
        serialised (and `<`-escaped) by src/lib/jsonld.ts. */}
    <script type="application/ld+json" is:inline set:html={jsonLd} />

    {/* The rest of the parity: `rel=sitemap` (Starlight emits its own on
        /docs/**), the raster icon set, the manifest, `theme-color` and the
        analytics beacon. Same string src/components/Head.astro emits, so the
        two heads cannot drift. The SVG icon link stays above it — a browser
        takes the first icon it understands. */}
    <Fragment set:html={commonHeadHtml(CF_BEACON_TOKEN, { sitemap: true })} />

    {/* Inlined, and first, so the theme is resolved before the first paint —
        same storage key Starlight's ThemeProvider uses, so a choice made here
        survives into /docs and back. The `data-theme` attribute is also what
        the shared <Diagram> component keys its light/dark SVG swap off. */}
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        let stored = null;
        try {
          stored = localStorage.getItem(KEY);
        } catch {
          /* private mode / storage disabled — fall through to the OS preference */
        }
        const theme =
          stored ||
          (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme === 'light' ? 'light' : 'dark';
      })();
    </script>
  </head>

  <body>
    <header class="masthead">
      <div class="shell masthead__inner">
        <a class="brand" href="/">
          <img src="/favicon.svg" alt="" width="32" height="32" />
          <span>MechCrate</span>
        </a>

        <nav class="masthead__nav" aria-label="Primary">
          <a href="#problems" data-optional>Why</a>
          <a href="#ai" data-optional>AI layer</a>
          <a href="/docs/">Docs</a>
          <a href="/docs/corpus/">Corpus</a>
          <a href={repo} rel="noopener">GitHub</a>
          <button
            class="theme-toggle"
            type="button"
            id="theme-toggle"
            aria-label="Toggle between light and dark theme"
          >
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>

    <main>
      {/* ---------------------------------------------------------- hero */}
      <section class="hero">
        <div class="shell hero__inner">
          <div>
            <p class="eyebrow">Meta-framework for service ecosystems</p>
            <h1>
              Stand up and operate <em>entire service ecosystems</em> — consistently, locally.
            </h1>
            <p class="hero__lede">
              An AI-native meta-framework with agents as first-class developers. Every repo has
              its own layout, its own env-var loading order, its own half-documented way to
              start the stack — humans burn onboarding time relearning it, agents burn tokens
              re-exploring it. <code>mx</code> makes the shape of a project the one thing
              nobody has to relearn.
            </p>

            <div class="terminal hero__install">
              <div class="terminal__bar">
                <span>Install</span>
                <button class="copy" type="button" data-command={installCommand}>Copy</button>
              </div>
              <div class="terminal__body">
                {
                  installLines.map((line) => (
                    <code>
                      <span class="prompt" aria-hidden="true">$ </span>
                      {line}
                    </code>
                  ))
                }
              </div>
            </div>
            <p class="hero__note">
              Installs the <code>mx</code> binary to <code>~/.local/bin</code> — no sudo. Then
              <code>mx doctor</code> tells you what else your machine needs.
            </p>

            <p class="hero__ctas">
              <a class="btn btn--primary" href={repo} rel="noopener">View on GitHub</a>
              <a class="btn btn--ghost" href="/docs/start/">Read the docs</a>
            </p>
          </div>

          <div class="hero__art">
            <Image
              src={logo}
              alt="The MechCrate raccoon: a goggled mechanic shouldering a wrench and carrying a wooden crate."
              width={512}
              loading="eager"
            />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------- problem one */}
      <section class="section problem" id="problems" data-side="left">
        <div class="shell">
          <div class="problem__head">
            <div class="problem__copy">
              <p class="eyebrow">The subset problem</p>
              <h2 class="section__title">You can&rsquo;t run all twelve services locally</h2>
              <p>
                Real ecosystems have ten or more services, and most of them are irrelevant to
                the feature you are building today. Running the lot on a laptop is not
                feasible, and pretending otherwise is how dev environments rot.
              </p>
              <p>
                mx makes the <em>subset</em> the unit of work. Every service gets its own
                atomic compose file — a baseline that describes its production shape, plus a
                dev override that adds hot-reload mounts, debug ports and relaxed health
                checks. Nothing forces all-or-nothing, and nothing about &ldquo;what runs
                where&rdquo; lives in tribal knowledge.
              </p>
            </div>

            <div class="problem__aside">
              <div class="terminal">
                <div class="terminal__bar">
                  <span>Pick your slice</span>
                </div>
                <div class="terminal__body">
                  <code><span class="prompt" aria-hidden="true">$ </span>make dev <span class="comment"># the whole stack</span></code>
                  <code><span class="prompt" aria-hidden="true">$ </span>make dev s=api <span class="comment"># just the one you're on</span></code>
                </div>
              </div>
              <ul class="callouts">
                <li>
                  <strong>docker/compose/&lt;service&gt;.yml</strong> — the baseline, the same
                  shape you deploy.
                </li>
                <li>
                  <strong>&lt;service&gt;.dev.yml</strong> — the override, merged only by
                  <code>make dev</code>.
                </li>
              </ul>
            </div>
          </div>

          <div class="problem__figure">
            <ComposeLayering />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------- problem two */}
      <section class="section section--tint problem" data-side="right">
        <div class="shell">
          <div class="problem__head">
            <div class="problem__copy">
              <p class="eyebrow">The context-switch problem</p>
              <h2 class="section__title">
                Switching organizations shouldn&rsquo;t mean tearing down your stack
              </h2>
              <p>
                Work across two organizations — or just two products — and the usual routine
                is misery: spin down ecosystem A&rsquo;s containers so ecosystem B&rsquo;s
                ports don&rsquo;t collide, lose your state, repeat tomorrow.
              </p>
              <p>
                The <strong>mx router</strong> is a single global Traefik instance that every
                mx project registers with. Application services publish no HTTP host ports;
                Traefik routes to them by hostname, so two ecosystems&rsquo; web apps never
                collide. Multiple ecosystems coexist on one machine, and switching context is
                <code>cd</code> — not teardown.
              </p>
            </div>

            <div class="problem__aside">
              <div class="terminal">
                <div class="terminal__bar">
                  <span>Stable hostnames</span>
                </div>
                <div class="terminal__body">
                  <code>http://api.localhost</code>
                  <code>http://admin.localhost</code>
                  <code>http://docs.localhost</code>
                </div>
              </div>
              <ul class="callouts">
                <li>
                  <strong>One router per machine.</strong> Installed once with
                  <code>mx router install &amp;&amp; mx router up</code>, it serves every
                  project you ever scaffold.
                </li>
                <li>
                  <strong>Backing services still get ports.</strong> Dev overrides expose
                  Postgres and Redis on their conventional ports for local GUI tools — per
                  compose file, easy to change.
                </li>
              </ul>
              <p class="aside-link">
                <a href="/docs/framework/">Read the full routing model →</a>
              </p>
            </div>
          </div>

          <div class="problem__figure">
            <EcosystemTopology />
          </div>
        </div>
      </section>

      {/* ----------------------------------------------- problem three */}
      <section class="section problem" data-side="left">
        <div class="shell">
          <div class="problem__head">
            <div class="problem__copy">
              <p class="eyebrow">The scaffolding problem</p>
              <h2 class="section__title">Scaffolding should carry wisdom, not boilerplate</h2>
              <p>
                Starting a new service usually means cobbling: copy a Dockerfile from the last
                project, hand-port the test harness, rediscover the admin-panel setup,
                re-solve deployment. Piecemeal, every time.
              </p>
              <p>
                mx <strong>recipes</strong> are production-shaped service definitions that
                carry the accumulated decisions of the stacks they came from — dependency
                choices, testing setup, admin tooling, dev overrides, deploy configuration —
                applied in one motion. And projects don&rsquo;t fork away from the framework:
                <code>mx upgrade</code> is how an existing project adopts newer scaffolding as
                the templates improve.
              </p>
            </div>

            <div class="problem__aside">
              <div class="terminal">
                <div class="terminal__bar">
                  <span>From nothing to a running service</span>
                </div>
                <div class="terminal__body">
                  <code><span class="prompt" aria-hidden="true">$ </span>mx new my-platform</code>
                  <code><span class="prompt" aria-hidden="true">$ </span>mx add api --recipe rust-api \</code>
                  <code>      --domain api.localhost</code>
                  <code><span class="prompt" aria-hidden="true">$ </span>make dev</code>
                </div>
              </div>
              <p class="caveat">
                <strong>Being straight with you:</strong> <code>mx upgrade</code> is currently
                mid-repair against the shipped template layout — tracked as
                <code>mech-crate-z5i</code>, with a red test asserting the fixed behaviour. A
                few recipes also still fail on a known templating defect. Both live in the
                <a href="/docs/project/">known-broken lane</a>, not in a backlog nobody reads.
              </p>
            </div>
          </div>

          <div class="problem__figure">
            <RecipeInstallFlow />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------ problem four */}
      <section class="section section--tint problem" data-side="right">
        <div class="shell">
          <div class="problem__head">
            <div class="problem__copy">
              <p class="eyebrow">The everything-else problem</p>
              <h2 class="section__title">The cobbled-together everything else</h2>
              <p>
                Environment loading, the local CLI, where files live, how you check the
                machine is healthy — the concerns every team solves badly, differently, once
                per project. mx standardises them once, in a folder contract that is
                deliberately non-negotiable.
              </p>
              <p>
                That contract is the point. It is what lets one <code>make dev</code> work
                everywhere, one router serve everything, and one MCP server understand any
                project without being told about it first.
              </p>
            </div>

            <div class="problem__aside">
              <ul class="callouts">
                <li>
                  <strong>Environment config</strong> — one documented loading order:
                  <code>.env.shared</code> → <code>.env.secrets</code> (gitignored) →
                  <code>.env.&lt;service&gt;</code>, all under <code>docker/.config/</code>.
                </li>
                <li>
                  <strong>A consistent CLI</strong> — <code>make dev / up / down / logs / sh /
                  ps / build / doctor</code> behave identically in every project, and
                  <code>mx</code> mirrors the same verbs globally.
                </li>
                <li>
                  <strong>Filesystem discipline</strong> — 1:1 host-to-container mounts under
                  <code>docker/system/</code>. What you see is what the container sees.
                </li>
                <li>
                  <strong>Documentation and health</strong> — <code>mx docs</code> compiles
                  project Markdown to PDF and HTML; <code>mx doctor</code> and
                  <code>make doctor</code> check dependencies before they ruin your afternoon.
                </li>
              </ul>
            </div>
          </div>

          <div class="problem__figure">
            <FolderContract />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------ AI layer */}
      <section class="section ai" id="ai">
        <div class="shell ai__inner">
          <div>
            <p class="eyebrow">The AI layer</p>
            <h2 class="section__title">AI that helps without leaking or wasting</h2>
            <p class="section__intro">
              Most &ldquo;AI-enabled&rdquo; development bolts a chatbot onto chaos. mx inverts
              it: make the terrain legible first, then arm the agent. Identical layouts and
              stable conventions mean an agent lands in familiar ground every session instead
              of re-deriving project shape before its first useful edit.
            </p>

            <ul class="features">
              <li>
                <h3>One MCP server, forty-plus tools</h3>
                <p>
                  <code>mx-mcp-server</code> groups its tools into four families — scaffold,
                  operate, understand, retrieve. An agent can create a service, start the
                  right subset of the stack, tail its logs and consult the corpus before
                  writing a line. <a href="/docs/ai/">How the AI layer works →</a>
                </p>
              </li>
              <li>
                <h3>A techniques corpus you host yourself</h3>
                <p>
                  RAG over curated engineering docs on pgvector, stored in a Postgres
                  <strong>you</strong> control — a Neon project or a local container, never a
                  third-party AI vendor&rsquo;s store. Embeddings go through any
                  OpenAI-compatible <code>/embeddings</code> endpoint: OpenAI by default, or
                  point <code>embedding_base_url</code> at Ollama or LM Studio to keep
                  ingestion and queries local too.
                  <a href="/docs/corpus/">Browse the published corpus →</a>
                </p>
              </li>
              <li>
                <h3>A corpus that grows on schedule</h3>
                <p>
                  A research skill runs weekly: it picks a topic, corroborates claims against
                  primary sources, and opens a pull request carrying provenance frontmatter
                  and a full source list. A human merges. The corpus grows on purpose, with an
                  audit trail. <a href="/docs/project/">Research log and backlog →</a>
                </p>
              </li>
            </ul>
          </div>

          <div class="ai__figure">
            <AiLoop />
          </div>
        </div>
      </section>

      {/* ------------------------------------------------ quality strip */}
      <section class="section section--tint" id="quality">
        <div class="shell">
          <p class="eyebrow">Quality</p>
          <h2 class="section__title">Proven gates, and a public list of what is broken</h2>
          <p class="section__intro">
            The three blocking gates — lint, test, coverage — are proven, not assumed. Each
            was demonstrated failing on a deliberately broken branch before the baseline
            landed, so we know they catch what they claim to catch. A release tag cannot ship
            unless its commit passes all three.
          </p>

          <ul class="gates">
            <li>
              <span class="tag tag--gate">Blocking gate</span>
              <code>make test</code>
              <p>Unit and integration suite plus doc-tests, on every PR and push to main.</p>
            </li>
            <li>
              <span class="tag tag--gate">Blocking gate</span>
              <code>make lint</code>
              <p>Clippy with warnings denied. One useless format string fails the build.</p>
            </li>
            <li>
              <span class="tag tag--gate">Blocking gate</span>
              <code>make coverage</code>
              <p>Line coverage against a ratcheting floor. Drops fail CI; raises are opt-in.</p>
            </li>
            <li>
              <span class="tag tag--report">Report</span>
              <code>make test-known-broken</code>
              <p>
                A TDD lane where every open, testable defect has a red test asserting its
                fixed behaviour.
              </p>
            </li>
            <li>
              <span class="tag tag--report">Report</span>
              <code>make test-e2e</code>
              <p>Scaffold → router → live URL against real Docker, on a dispatched workflow.</p>
            </li>
            <li>
              <span class="tag tag--report">Report</span>
              <code>make test-mutants</code>
              <p>Scheduled mutation testing over the core library, as a weekly report.</p>
            </li>
          </ul>

          <div class="known-broken">
            <h3>The known-broken lane</h3>
            <p>
              We would rather publicly index our own defects than pretend there aren&rsquo;t
              any. <code>mx upgrade</code> (<code>mech-crate-z5i</code>) and the corpus&rsquo;s
              lexical retrieval arm (<code>mech-crate-4jw</code>) are both open and both
              named — each with a red test that asserts the behaviour we owe you.
            </p>
            <p>
              Un-ignoring that test is the fix&rsquo;s definition of done. It is a report, not
              a gate, which is exactly why it can afford to be honest.
              <a href="/docs/project/">See the lane and the research log →</a>
            </p>
          </div>
        </div>
      </section>

      {/* ------------------------------------------------------ final CTA */}
      <section class="cta" id="install">
        <div class="shell cta__inner">
          <h2>A developer who knows one mx project knows all of them</h2>
          <p class="lede">
            Install the CLI, bring up the router once, and scaffold your first project. The
            second one will look exactly like it — which is the whole idea.
          </p>

          <div class="terminal">
            <div class="terminal__bar">
              <span>Get started</span>
              <button class="copy" type="button" data-command={startCommand}>Copy</button>
            </div>
            <div class="terminal__body">
              {
                installLines.map((line) => (
                  <code>
                    <span class="prompt" aria-hidden="true">$ </span>
                    {line}
                  </code>
                ))
              }
              <code><span class="prompt" aria-hidden="true">$ </span>mx router install &amp;&amp; mx router up</code>
              <code><span class="prompt" aria-hidden="true">$ </span>mx new my-app <span class="comment"># and you're building</span></code>
            </div>
          </div>

          <p class="hero__ctas">
            <a class="btn btn--primary" href="/docs/start/">Start here</a>
            <a class="btn btn--ghost" href={repo} rel="noopener">View on GitHub</a>
          </p>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="shell">
        <div class="footer__inner">
          <a class="brand" href="/">
            <img src="/favicon.svg" alt="" width="32" height="32" />
            <span>MechCrate</span>
          </a>

          <nav aria-label="Footer">
            <a href="/docs/start/">Start</a>
            <a href="/docs/framework/">Framework</a>
            <a href="/docs/ai/">AI Layer</a>
            <a href="/docs/corpus/">Techniques Corpus</a>
            <a href="/docs/project/">Project</a>
            <a href={repo} rel="noopener">GitHub</a>
          </nav>
        </div>

        <div class="footer__meta">
          <span>
            Licensed under
            <a href={`${repo}/blob/main/LICENSE-APACHE`} rel="noopener">Apache-2.0</a>
            or
            <a href={`${repo}/blob/main/LICENSE-MIT`} rel="noopener">MIT</a>, at your option.
          </span>
          <span class="signoff">🦝 Crate Raccoon says: happy building.</span>
        </div>
      </div>
    </footer>

    {/* Two behaviours, both progressive enhancements: the theme toggle writes the
        key the head script (and Starlight) reads, and the copy buttons put the
        command on the clipboard. Inlined rather than bundled so the page ships
        zero extra network requests; without JS the page is fully readable and the
        theme still follows the OS preference. */}
    <script is:inline>
      (() => {
        const KEY = 'starlight-theme';
        const root = document.documentElement;

        const toggle = document.getElementById('theme-toggle');
        if (toggle) {
          toggle.addEventListener('click', () => {
            const next = root.dataset.theme === 'light' ? 'dark' : 'light';
            root.dataset.theme = next;
            try {
              localStorage.setItem(KEY, next);
            } catch {
              /* storage disabled — the toggle still works for this page view */
            }
          });
        }

        for (const button of document.querySelectorAll('.copy[data-command]')) {
          button.addEventListener('click', async () => {
            const command = button.dataset.command;
            if (!command) return;
            try {
              await navigator.clipboard.writeText(command);
            } catch {
              return; // no clipboard permission; leave the label untouched
            }
            const original = button.textContent;
            button.textContent = 'Copied';
            button.dataset.copied = 'true';
            setTimeout(() => {
              button.textContent = original;
              delete button.dataset.copied;
            }, 1600);
          });
        }
      })();
    </script>
  </body>
</html>
